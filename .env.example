# ---- Database -------------------------------------------------------------
# App role: subject to row-level security. Owner role: migrations only.
DATABASE_URL=postgresql://riverbend_app:riverbend_app@localhost:5432/riverbend
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/riverbend
APP_DB_PASSWORD=riverbend_app

# ---- LLM provider: azure | fake --------------------------------------------
# `fake` replays recorded responses from samples/recorded/ and needs no key.
LLM_PROVIDER=fake
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# "v1" = the OpenAI-compatible /openai/v1 surface on an Azure AI Services resource (needed for gpt-5*);
# otherwise a classic api-version such as 2024-10-21.
AZURE_OPENAI_API_VERSION=v1
# gpt-5 family only; reasoning tokens count as output, so raise LLM_MAX_OUTPUT_TOKENS with it
LLM_REASONING_EFFORT=low
# Price table for the spend ledger (USD per 1M tokens). Azure rates vary by region.
LLM_PRICE_INPUT_USD_PER_1M=0.25
LLM_PRICE_OUTPUT_USD_PER_1M=2.00
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=3000
# Fault injection for demos and tests: down | slow | garbage (leave empty normally)
LLM_FAULT=
LLM_RECORD_DIR=samples/recorded

# ---- Queue: Google Pub/Sub (emulator locally) ------------------------------
DISPATCHER=pubsub
PUBSUB_PROJECT=riverbend-local
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_TOPIC=work-order-jobs
PUBSUB_SUBSCRIPTION=work-order-jobs-push
PUBSUB_DLQ_TOPIC=work-order-jobs-dlq
PUBSUB_DLQ_SUBSCRIPTION=work-order-jobs-dlq-push
PUBSUB_PUSH_ENDPOINT=http://worker:8081/pubsub/push
PUBSUB_DLQ_PUSH_ENDPOINT=http://worker:8081/pubsub/dlq

# ---- Policy ----------------------------------------------------------------
DEFAULT_MONTHLY_CAP_USD=25
FOLLOWUP_EXPIRY_DAYS=7
BREAKER_FAILURE_THRESHOLD=3
BREAKER_OPEN_SECONDS=60

# text = one aligned line per event (terminal); json = one object per line (Cloud Logging)
LOG_FORMAT=text
LOG_LEVEL=INFO
